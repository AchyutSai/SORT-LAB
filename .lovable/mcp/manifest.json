{
  "version": 1,
  "sdk_version": "0.27.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ihusjxxxxhbdmeccwwcl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "algorithm-arena",
      "version": "0.1.0",
      "title": "Algorithm Arena"
    },
    "tools": [
      {
        "name": "list_algorithms",
        "title": "List sorting algorithms",
        "description": "Reference data for every sorting algorithm SortLab benchmarks: time and space complexity, stability, in-place behaviour, plus the available data distributions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_benchmark_runs",
        "title": "List my benchmark runs",
        "description": "List the signed-in user's saved SortLab benchmark runs, newest first, with distribution, sizes and visibility.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Maximum number of runs to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_benchmark_run",
        "title": "Get a benchmark run",
        "description": "Fetch one SortLab benchmark run with all of its per-algorithm metrics (input size, execution time in ms, comparisons, swaps). Works for the user's own runs and for any public run.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The benchmark run id (UUID)."
            }
          },
          "required": [
            "run_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "save_benchmark_run",
        "title": "Save a benchmark run",
        "description": "Store a SortLab benchmark run and its per-algorithm metrics for the signed-in user. Use this to import results measured elsewhere.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "run_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Human-readable name for the run."
            },
            "array_distribution": {
              "type": "string",
              "enum": [
                "random",
                "nearly",
                "reversed",
                "duplicates"
              ],
              "description": "Data distribution the arrays were generated with."
            },
            "max_input_size": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Largest array size tested."
            },
            "step_size": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Increment between tested array sizes."
            },
            "repeats": {
              "default": 3,
              "description": "Runs averaged per step.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "is_public": {
              "default": true,
              "description": "Whether the run appears on the public leaderboard.",
              "type": "boolean"
            },
            "metrics": {
              "minItems": 1,
              "maxItems": 2000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "algorithm_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input_size": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "execution_time_ms": {
                    "type": "number",
                    "minimum": 0
                  },
                  "comparisons": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "swaps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "algorithm_name",
                  "input_size",
                  "execution_time_ms"
                ]
              },
              "description": "Measured data points."
            }
          },
          "required": [
            "run_name",
            "array_distribution",
            "max_input_size",
            "step_size",
            "metrics"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_benchmark_run",
        "title": "Delete a benchmark run",
        "description": "Permanently delete one of the signed-in user's saved benchmark runs and all of its metrics.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The benchmark run id (UUID) to delete."
            }
          },
          "required": [
            "run_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_public_runs",
        "title": "List public benchmark runs",
        "description": "Browse the public SortLab leaderboard: benchmark runs other users published, optionally filtered by data distribution.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "distribution": {
              "description": "Only return runs generated with this data distribution.",
              "type": "string",
              "enum": [
                "random",
                "nearly",
                "reversed",
                "duplicates"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of runs to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}

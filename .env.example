# -------------------------------------------------------------
# Supabase Configuration
# -------------------------------------------------------------
# Frontend public keys (safe to expose to browser)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Backend server keys (used by server functions / SSR)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_PROJECT_ID="your-project-id"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -------------------------------------------------------------
# AI Assistant Provider (Choose ONE or more)
# Stored strictly on server — NEVER prefixed with VITE_
# -------------------------------------------------------------

# Option 1: Google Gemini (Recommended)
GEMINI_API_KEY="AIzaSy..."
# AI_MODEL="gemini-1.5-flash"  # Optional override

# Option 2: OpenAI
# OPENAI_API_KEY="sk-proj-..."
# AI_MODEL="gpt-4o-mini"      # Optional override

# Option 3: Anthropic Claude
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-3-5-haiku-latest" # Optional override

# Option 4: Generic OpenAI-Compatible (Ollama, Groq, DeepSeek, etc.)
# AI_API_KEY="your-key"
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="llama-3.1-70b-versatile"
